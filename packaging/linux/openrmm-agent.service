[Unit]
Description=open-rmm endpoint management agent
Documentation=https://github.com/stefanozanarini/open-rmm
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
# The installed version is selected by the drop-in
# openrmm-agent.service.d/50-openrmm-version.conf, written by the package and
# by the watchdog when it applies an update.
ExecStart=/opt/open-rmm/versions/initial/openrmm-agent run -config /etc/open-rmm/agent.json
Restart=always
RestartSec=5s

StateDirectory=open-rmm
StateDirectoryMode=0700
ConfigurationDirectory=open-rmm
UMask=0077

# Hardening. The agent runs as root because management modules need it;
# these options limit what the core itself can do.
ProtectSystem=full
# The agent updates the watchdog unit's version drop-in.
ReadWritePaths=-/etc/systemd/system/openrmm-watchdog.service.d
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
