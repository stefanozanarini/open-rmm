[Unit]
Description=Tempra RMM endpoint management agent
Documentation=https://github.com/stefanozanarini/tempra-rmm
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
# The installed version is selected by the drop-in
# openrmm-agent.service.d/50-openrmm-version.conf, written by the package and
# by the watchdog when it applies an update.
ExecStart=/opt/open-rmm/versions/initial/openrmm-agent run -config /etc/open-rmm/agent.json
Restart=always
RestartSec=5s

StateDirectory=open-rmm
StateDirectoryMode=0700
ConfigurationDirectory=open-rmm
ConfigurationDirectoryMode=0700
# Package scripts run by modules inherit the umask: a restrictive one would
# leave files they create unreadable to services. The agent writes its own
# secrets with explicit permissions.
UMask=0022
# An agent restart (self-update) must not kill a package installation in
# progress, which would leave dpkg or rpm half done.
KillMode=process

# No filesystem or kernel hardening: modules run as children of the agent
# and install packages and kernels (apt, dnf, zypper), which write /usr,
# /etc and /boot, create setuid files and load kernel modules. Like the
# Windows agent running as SYSTEM, the agent has root's full rights; what
# it may run is decided by signed jobs and policies, not by the unit.
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
