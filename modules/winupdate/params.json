{
  "scan": [
    {
      "name": "max_age_days",
      "type": "int",
      "label": {
        "it": "Segnala gli aggiornamenti di sicurezza mancanti da più di (giorni)",
        "en": "Flag security updates missing for more than (days)"
      },
      "default": 30,
      "min": 0,
      "max": 365
    }
  ],
  "install": [
    {
      "name": "classifications",
      "type": "multi",
      "label": {
        "it": "Classificazioni",
        "en": "Classifications"
      },
      "options": [
        {
          "value": "security",
          "label": {
            "it": "Sicurezza",
            "en": "Security"
          }
        },
        {
          "value": "critical",
          "label": {
            "it": "Critici",
            "en": "Critical"
          }
        },
        {
          "value": "rollup",
          "label": {
            "it": "Aggiornamenti cumulativi",
            "en": "Update rollups"
          }
        },
        {
          "value": "update",
          "label": {
            "it": "Aggiornamenti",
            "en": "Updates"
          }
        },
        {
          "value": "definition",
          "label": {
            "it": "Definizioni",
            "en": "Definitions"
          }
        },
        {
          "value": "driver",
          "label": {
            "it": "Driver",
            "en": "Drivers"
          }
        },
        {
          "value": "feature_pack",
          "label": {
            "it": "Feature pack",
            "en": "Feature packs"
          }
        },
        {
          "value": "service_pack",
          "label": {
            "it": "Service pack",
            "en": "Service packs"
          }
        },
        {
          "value": "tools",
          "label": {
            "it": "Strumenti",
            "en": "Tools"
          }
        },
        {
          "value": "upgrade",
          "label": {
            "it": "Upgrade di versione",
            "en": "Upgrades"
          }
        }
      ],
      "default": [
        "security",
        "critical",
        "rollup",
        "update",
        "definition"
      ]
    },
    {
      "name": "include_kbs",
      "type": "list",
      "label": {
        "it": "Solo questi KB",
        "en": "Only these KBs"
      },
      "help": {
        "it": "Uno per riga, es. KB5034441. Vuoto: tutti quelli delle classificazioni scelte.",
        "en": "One per line, e.g. KB5034441. Empty: all of the selected classifications."
      }
    },
    {
      "name": "exclude_kbs",
      "type": "list",
      "label": {
        "it": "Escludi questi KB",
        "en": "Exclude these KBs"
      }
    },
    {
      "name": "allow_managed",
      "type": "bool",
      "label": {
        "it": "Installa anche se gestito da WSUS/Intune",
        "en": "Install even if managed by WSUS/Intune"
      },
      "default": false
    }
  ],
  "repair": [
    {
      "name": "source",
      "type": "string",
      "label": {
        "it": "Sorgente dei file (facoltativa)",
        "en": "File source (optional)"
      },
      "help": {
        "it": "Un'immagine della stessa build, es. WIM:D:\\sources\\install.wim:1 o una cartella condivisa. Vuota: i file vengono scaricati da Windows Update.",
        "en": "An image of the same build, e.g. WIM:D:\\sources\\install.wim:1 or a shared folder. Empty: the files are downloaded from Windows Update."
      }
    },
    {
      "name": "sfc",
      "type": "bool",
      "label": {
        "it": "Verifica anche i file di sistema (sfc /scannow)",
        "en": "Also check the system files (sfc /scannow)"
      },
      "default": true
    },
    {
      "name": "reset_components",
      "type": "bool",
      "label": {
        "it": "Azzera prima la cache di Windows Update (SoftwareDistribution, catroot2)",
        "en": "First reset the Windows Update cache (SoftwareDistribution, catroot2)"
      },
      "default": false
    }
  ],
  "logs": [
    {
      "name": "days",
      "type": "int",
      "label": {
        "it": "Giorni di eventi da raccogliere",
        "en": "Days of events to collect"
      },
      "default": 7,
      "min": 1,
      "max": 30
    },
    {
      "name": "windowsupdate_log",
      "type": "bool",
      "label": {
        "it": "Includi WindowsUpdate.log (decodifica lenta, alcuni minuti)",
        "en": "Include WindowsUpdate.log (slow decoding, a few minutes)"
      },
      "default": false
    }
  ]
}
