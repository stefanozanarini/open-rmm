# Copy to .env and replace the values. Use URL-safe passwords, e.g.
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me
OPENRMM_DB_PASSWORD=change-me
# Port published on the host for the agents endpoint.
OPENRMM_PUBLIC_PORT=443
# Gateway tunnel address seen by the core. Default: the gateway container of
# this stack. With a separate DMZ host: <dmz-host>:8444, and
# OPENRMM_GATEWAY_NAME=<DNS name in the gateway certificate>.
#OPENRMM_GATEWAY_TUNNEL=gateway:8444
#OPENRMM_GATEWAY_NAME=agent.cliente.it

# --- Web console (see docs/ENTRA.md) ---
# URL used by the operators' browsers. Must be https (certificate below, or a
# TLS reverse proxy in front of the console).
OPENRMM_PUBLIC_URL=https://console.cliente.it
# Host address the console listens on: an address on the operators' LAN,
# never one reachable from the internet.
OPENRMM_CONSOLE_BIND=127.0.0.1:8080
# Optional: serve HTTPS directly (files in deploy/console-tls/).
OPENRMM_CONSOLE_TLS_CERT=
OPENRMM_CONSOLE_TLS_KEY=
OPENRMM_OIDC_ISSUER=https://login.microsoftonline.com/<entra-tenant-id>/v2.0
OPENRMM_OIDC_CLIENT_ID=<application-client-id>
# "amr" or "acrs:<authentication context id>" (recommended with Entra ID P1)
OPENRMM_MFA_CLAIM=amr
# <entra-tenant-id>=<open-rmm tenant id>
OPENRMM_TENANT_MAP=
# With several directories in OPENRMM_TENANT_MAP (one console for several
# customers): the directory (or directories) whose Admins manage console-wide
# settings, such as the key that signs every tenant's installers. With one
# directory it is that one.
#OPENRMM_CONSOLE_ADMIN_TENANT=<entra-tenant-id>

# Optional Trend Vision One connector (read-only). The open-rmm tenant id whose
# endpoints are compared with Vision One, and the API region (eu = Frankfurt).
# The API key goes in secrets/core/visionone-key (deploy/setup-secrets.sh).
OPENRMM_VISIONONE_TENANT=
OPENRMM_VISIONONE_REGION=eu

# --- Federation (optional, see docs/FEDERATION.md) ---
# Central console: listener for the links opened by customer consoles. Publish
# it where customer consoles can reach it (internet), e.g. 0.0.0.0:8445, and
# give the address they dial (put in the link tokens).
#OPENRMM_FEDERATION_LISTEN=:8445
#OPENRMM_FEDERATION_BIND=0.0.0.0:8445
#OPENRMM_FEDERATION_PUBLIC_ADDR=central.msp.it:8445
# Customer console: the central console's Entra directory, trusted by the web
# console AND the signer. Without these the link carries nothing.
#OPENRMM_FEDERATION_ISSUER=https://login.microsoftonline.com/<central-entra-tenant-id>/v2.0
#OPENRMM_FEDERATION_CLIENT_ID=<central console application client id>
#OPENRMM_FEDERATION_MFA_CLAIM=amr
# <central-entra-tenant-id>=<open-rmm tenant id of this console>
#OPENRMM_FEDERATION_TENANT_MAP=
# Highest role central operators get here: OpenRMM.Admin (default),
# OpenRMM.Operator or OpenRMM.Reader (read-only delegation).
#OPENRMM_FEDERATION_MAX_ROLE=OpenRMM.Admin

# --- Agent installers (signed MSI preconfigured for this console) ---
# Built by the builder service from the Agent installation page. The MSI
# carries these values and a dedicated enrollment token (agents still wait for
# approval). The root certificate is read from pki/ca/root-ca.crt.
# Gateway address the agents dial (DNS name of setup-pki.sh, public port):
OPENRMM_AGENT_SERVER=agent.cliente.it:443
# Public keys: commands (printed by setup-secrets.sh), modules, agent releases.
OPENRMM_AGENT_JOB_KEYS=
OPENRMM_MODULE_KEYS=
OPENRMM_RELEASE_KEYS=
# RFC 3161 timestamp server for the signatures ("none" to skip).
#OPENRMM_SIGN_TIMESTAMP=http://timestamp.digicert.com
